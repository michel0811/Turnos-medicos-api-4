{
  "name": "turnos-med-api4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "author": "Daniel Oscar Michel",
  "description": "Actividad 4: mockup de pacientes y turnos y documentación integral",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:postman": "node scripts/run-postman.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "typescript": "6.0.3",
    "newman": "6.2.1"
  }
}
